# Copy to .env and fill in real values. Never commit .env.
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealership_dev
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Browser origin(s) allowed to call the API (the deployed frontend). Comma-separated; leave unset locally (the Vite proxy needs no CORS).
# FRONTEND_ORIGIN=https://your-garage.vercel.app
