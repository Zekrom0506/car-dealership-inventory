// Database schema. Run `npm run db:migrate` after changing this file.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// The connection URL comes from DATABASE_URL (see prisma.config.ts).
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  @@map("users")
}

/// The fixed list of vehicle categories (decision 7).
enum Category {
  Sedan
  SUV
  Hatchback
  Truck
  Coupe
  Convertible
  Van
}

model Vehicle {
  id        Int      @id @default(autoincrement())
  make      String
  model     String
  category  Category
  /// Whole currency units (no decimals).
  price     Int
  /// Units in stock; never negative.
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}
